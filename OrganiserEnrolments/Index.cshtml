@model RaceDay.Mvc.Models.EnrolmentManagementViewModel

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Event Enrolments</h2>
            <p class="text-muted">
                View participants and record their race results.
            </p>
        </div>

        <a asp-controller="Organiser"
           asp-action="Events"
           class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Participants</h5>

            @if (Model.Enrolments == null || !Model.Enrolments.Any())
            {
                <div class="alert alert-info">
                    No participants have enrolled in this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-dark">
                            <tr>
                                <th>Participant</th>
                                <th>Email</th>
                                <th>Category</th>
                                <th>Distance</th>
                                <th>Race Number</th>
                                <th>Enrolment Status</th>
                                <th>Record Result</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model.Enrolments)
                            {
                                <tr>
                                    <td>
                                        @(item.Participant?.FirstName ?? "")
                                        @(item.Participant?.LastName ?? "")
                                    </td>

                                    <td>
                                        @(item.Participant?.Email ?? "N/A")
                                    </td>

                                    <td>
                                        @(item.Category?.CategoryName ?? "N/A")
                                    </td>

                                    <td>
                                        @(item.Category?.DistanceKm.ToString("0.##") ?? "N/A") km
                                    </td>

                                    <td>
                                        @(item.RaceNumber?.ToString() ?? "Not assigned")
                                    </td>

                                    <td>
                                        @if (item.Status == "Confirmed")
                                        {
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        }
                                        else if (item.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status == "Confirmed")
                                        {
                                            <details>
                                                <summary class="btn btn-sm btn-primary">
                                                    Enter Result
                                                </summary>

                                                <form asp-controller="OrganiserEnrolments"
                                                      asp-action="SaveResult"
                                                      method="post"
                                                      class="mt-3">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="EnrolmentID"
                                                           value="@item.EnrolmentID" />

                                                    <input type="hidden"
                                                           name="EventID"
                                                           value="@Model.EventID" />

                                                    <div class="mb-2">
                                                        <label class="form-label">
                                                            Finish Time
                                                        </label>

                                                        <input type="time"
                                                               name="FinishTime"
                                                               class="form-control"
                                                               value="00:00"
                                                               required />
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label">
                                                            Position
                                                        </label>

                                                        <input type="number"
                                                               name="Position"
                                                               class="form-control"
                                                               min="1"
                                                               placeholder="e.g. 1" />
                                                    </div>

                                                    <div class="mb-2">
                                                        <label class="form-label">
                                                            Result Status
                                                        </label>

                                                        <select name="ResultStatus"
                                                                class="form-select"
                                                                required>
                                                            <option value="Finished">
                                                                Finished
                                                            </option>
                                                            <option value="DidNotFinish">
                                                                Did Not Finish
                                                            </option>
                                                            <option value="Disqualified">
                                                                Disqualified
                                                            </option>
                                                        </select>
                                                    </div>

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm">
                                                        Save Result
                                                    </button>
                                                </form>
                                            </details>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Not available
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>