@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">
    <div class="text-center py-5">
        <h1 class="display-3 fw-bold text-primary">
            RACEDAY
        </h1>

        <h2 class="mt-3">
            Every Race. Every Runner. One Platform.
        </h2>

        <p class="lead mt-3">
            Manage sporting events, register participants,
            track enrolments and record race results.
        </p>

        <div class="mt-4">
            <a href="/Account/Register"
               class="btn btn-primary btn-lg me-2">
                Create Account
            </a>

            <a href="/Account/Login"
               class="btn btn-outline-primary btn-lg">
                Sign In
            </a>
        </div>
    </div>

    <hr />

    <div id="features" class="row text-center mt-5">
        <div class="col-md-4 mb-4">
            <h3>🏃 Participants</h3>
            <p>Discover events and manage your race enrolments.</p>
        </div>

        <div class="col-md-4 mb-4">
            <h3>📋 Organisers</h3>
            <p>Create events, manage categories and record results.</p>
        </div>

        <div class="col-md-4 mb-4">
            <h3>🏆 Results</h3>
            <p>Keep track of race positions and finishing times.</p>
        </div>
    </div>
</div>
