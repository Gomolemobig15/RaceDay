@model List<RaceDay.Mvc.Models.ParticipantResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-4">

    <h2>My Race Results</h2>
    <p class="text-muted">
        View your recorded event results and finishing positions.
    </p>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any recorded results yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Event Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model)
                    {
                        <tr>
                            <td>
                                @(result.Enrolment?.Category?.Event?.EventName ?? "N/A")
                            </td>

                            <td>
                                @result.Enrolment?.Category?.Event?.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @(result.Enrolment?.Category?.CategoryName ?? "N/A")
                            </td>

                            <td>
                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                            </td>

                            <td>
                                @(result.Position?.ToString() ?? "N/A")
                            </td>

                            <td>
                                @if (result.ResultStatus == "Finished")
                                {
                                    <span class="badge bg-success">
                                        Finished
                                    </span>
                                }
                                else if (result.ResultStatus == "Disqualified")
                                {
                                    <span class="badge bg-danger">
                                        Disqualified
                                    </span> 
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Did Not Finish
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
</div>