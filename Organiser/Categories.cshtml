@model List<RaceDay.Mvc.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Manage Categories";
    int eventId = (int)ViewBag.EventID;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">
                Add, edit and manage event categories.
            </p>
        </div>

        <a href="/Organiser/Events"
           class="btn btn-outline-secondary">
            Back to Events
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Add New Category</h5>

            <form asp-controller="Organiser"
                  asp-action="CreateCategory"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="EventID"
                       value="@eventId" />

                <div class="mb-3">
                    <label class="form-label">Category Name</label>

                    <input name="CategoryName"
                           class="form-control"
                           placeholder="Example: 5KM Fun Run"
                           maxlength="100"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Distance (KM)</label>

                    <input name="DistanceKm"
                           type="number"
                           step="0.1"
                           min="0.1"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Entry Fee (R)</label>

                    <input name="EntryFee"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Maximum Participants
                    </label>

                    <input name="MaximumParticipants"
                           type="number"
                           min="1"
                           class="form-control"
                           placeholder="Leave blank for unlimited" />
                </div>

                <button type="submit" class="btn btn-primary">
                    + Add Category
                </button>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="fw-bold mb-3">Existing Categories</h5>

            @if (Model == null || Model.Count == 0)
            {
                <div class="alert alert-info">
                    No categories have been added to this event yet.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover">

                        <thead>
                            <tr>
                                <th>Category</th>
                                <th>Distance</th>
                                <th>Entry Fee</th>
                                <th>Maximum Participants</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td>@category.CategoryName</td>

                                    <td>@category.DistanceKm km</td>

                                    <td>
                                        R @category.EntryFee.ToString("N2")
                                    </td>

                                    <td>
                                        @(category.MaximumParticipants?.ToString()
                                            ?? "Unlimited")
                                    </td>

                                    <td>
                                        <details>
                                            <summary class="btn btn-sm btn-warning">
                                                Edit
                                            </summary>

                                            <form asp-controller="Organiser"
                                                  asp-action="EditCategory"
                                                  method="post"
                                                  class="mt-3">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="categoryId"
                                                       value="@category.CategoryID" />

                                                <input type="hidden"
                                                       name="EventID"
                                                       value="@eventId" />

                                                <div class="mb-2">
                                                    <label>Category Name</label>

                                                    <input name="CategoryName"
                                                           value="@category.CategoryName"
                                                           class="form-control"
                                                           maxlength="100"
                                                           required />
                                                </div>

                                                <div class="mb-2">
                                                    <label>Distance (KM)</label>

                                                    <input name="DistanceKm"
                                                           type="number"
                                                           step="0.1"
                                                           min="0.1"
                                                           value="@category.DistanceKm"
                                                           class="form-control"
                                                           required />
                                                </div>

                                                <div class="mb-2">
                                                    <label>Entry Fee (R)</label>

                                                    <input name="EntryFee"
                                                           type="number"
                                                           step="0.01"
                                                           min="0"
                                                           value="@category.EntryFee"
                                                           class="form-control"
                                                           required />
                                                </div>

                                                <div class="mb-2">
                                                    <label>Maximum Participants</label>

                                                    <input name="MaximumParticipants"
                                                           type="number"
                                                           min="1"
                                                           value="@category.MaximumParticipants"
                                                           class="form-control" />
                                                </div>

                                                <button type="submit"
                                                        class="btn btn-success btn-sm">
                                                    Save Changes
                                                </button>

                                            </form>
                                        </details>

                                        <form asp-controller="Organiser"
                                              asp-action="DeleteCategory"
                                              method="post"
                                              class="mt-2"
                                              onsubmit="return confirm('Delete this category?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="categoryId"
                                                   value="@category.CategoryID" />

                                            <input type="hidden"
                                                   name="eventId"
                                                   value="@eventId" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Delete
                                            </button>

                                        </form>
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
